# Non-secret runtime configuration. Copy this to the Firebase-supported env file
# for the selected development, staging, or production project. Each environment
# must use its own Firebase project, allowed origins, return URLs, provider mode,
# and plan identifiers; never reuse live provider secrets in development/staging.
ALLOWED_WEB_ORIGINS=https://algoglyph.com
CHECKOUT_SUCCESS_URL=https://algoglyph.com/workspace?billing=success
CHECKOUT_CANCEL_URL=https://algoglyph.com/workspace?billing=cancelled
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=

# Configure these with `firebase functions:secrets:set`; never place values here.
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET

# BillDesk is intentionally not configured or exposed until the merchant's
# official integration contract is available. Do not invent credential names
# or signing rules; see ../docs/billing-deployment.md.
