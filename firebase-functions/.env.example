# Non-secret runtime configuration. Use separate values per Firebase project.
ALLOWED_WEB_ORIGINS=https://algoglyph.com
CHECKOUT_SUCCESS_URL=https://algoglyph.com/workspace?billing=success
CHECKOUT_CANCEL_URL=https://algoglyph.com/workspace?billing=cancelled
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=

# Configure these with `firebase functions:secrets:set`; never place values here.
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET
