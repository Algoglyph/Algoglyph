# Some transitive dependencies (e.g. @radix-ui/* pulled in by @excalidraw/excalidraw)
# still declare a React 16/17/18 peer, while this project runs React 19. Those peers
# are satisfied in practice — the app builds and runs on React 19 — so npm's ERESOLVE
# warnings are noise. legacy-peer-deps makes `npm install` / `npm ci` resolve cleanly
# and quietly instead of printing a wall of peer-dependency warnings.
legacy-peer-deps=true
