# /workspace and /roadmap are real built HTML entry points (workspace.html,
# roadmap.html — see vite.config.ts), served as static assets by Cloudflare
# Pages just like /privacy and /terms. Each boots the full App, which renders
# the right view from location.pathname.
#
# We deliberately do NOT rewrite them to /index.html here: Cloudflare Pages
# canonicalizes an /index.html destination and bounces the request to `/`,
# which is what sent hard refreshes back to the landing page.

# SPA rewrite for the blog section subpaths (e.g. /blog/arrays -> /blog.html)
/blog/*  /blog.html  200
