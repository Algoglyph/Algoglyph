rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function workspaceStatus(workspaceId) {
      let workspacePath = /databases/$(database)/documents/workspaces/$(workspaceId);
      return exists(workspacePath) ? get(workspacePath).data.status : null;
    }
    function workspaceMember(workspaceId) {
      return signedIn()
        && workspaceStatus(workspaceId) in ['active', 'deleting']
        && exists(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid)).data.status == 'active';
    }
    function workspaceMemberAfter(workspaceId) {
      let memberPath = /databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid);
      return signedIn()
        && existsAfter(memberPath)
        && getAfter(memberPath).data.workspaceId == workspaceId
        && getAfter(memberPath).data.uid == request.auth.uid
        && getAfter(memberPath).data.status == 'active';
    }
    function workspaceRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid)).data.role;
    }
    function workspaceEditor(workspaceId) {
      return workspaceMember(workspaceId)
        && workspaceStatus(workspaceId) == 'active'
        && workspaceRole(workspaceId) in ['owner', 'admin', 'member'];
    }
    function workspaceAdmin(workspaceId) {
      return workspaceMember(workspaceId)
        && workspaceStatus(workspaceId) == 'active'
        && workspaceRole(workspaceId) in ['owner', 'admin'];
    }
    function workspaceAdminForDelete(workspaceId) {
      return workspaceMember(workspaceId) && workspaceRole(workspaceId) in ['owner', 'admin'];
    }
    function workspaceOwnerForDelete(workspaceId) {
      let workspacePath = /databases/$(database)/documents/workspaces/$(workspaceId);
      let memberPath = /databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid);
      return signedIn()
        && workspaceStatus(workspaceId) in ['active', 'deleting']
        && exists(workspacePath)
        && get(workspacePath).data.ownerId == request.auth.uid
        && exists(memberPath)
        && get(memberPath).data.role == 'owner'
        && get(memberPath).data.status == 'active';
    }
    function canvasActive(workspaceId, canvasId) {
      let canvasPath = /databases/$(database)/documents/workspaces/$(workspaceId)/canvases/$(canvasId);
      return exists(canvasPath) && get(canvasPath).data.status == 'active';
    }
    function organizationMember(organizationId) {
      let organizationPath = /databases/$(database)/documents/organizations/$(organizationId);
      return signedIn()
        && exists(organizationPath)
        && get(organizationPath).data.status in ['active', 'deleting']
        && exists(/databases/$(database)/documents/organizationMembers/$(organizationId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/organizationMembers/$(organizationId + '_' + request.auth.uid)).data.status == 'active';
    }
    function organizationAdmin(organizationId) {
      let organizationPath = /databases/$(database)/documents/organizations/$(organizationId);
      let memberPath = /databases/$(database)/documents/organizationMembers/$(organizationId + '_' + request.auth.uid);
      return organizationMember(organizationId)
        && get(organizationPath).data.status == 'active'
        && get(memberPath).data.role in ['owner', 'admin'];
    }
    function organizationAdminForDelete(organizationId) {
      let organizationPath = /databases/$(database)/documents/organizations/$(organizationId);
      let memberPath = /databases/$(database)/documents/organizationMembers/$(organizationId + '_' + request.auth.uid);
      return organizationMember(organizationId)
        && get(organizationPath).data.status in ['active', 'deleting']
        && get(memberPath).data.role in ['owner', 'admin'];
    }
    function organizationOwnerForDelete(organizationId) {
      let organizationPath = /databases/$(database)/documents/organizations/$(organizationId);
      let memberPath = /databases/$(database)/documents/organizationMembers/$(organizationId + '_' + request.auth.uid);
      return signedIn()
        && exists(organizationPath)
        && get(organizationPath).data.status in ['active', 'deleting']
        && get(organizationPath).data.ownerId == request.auth.uid
        && exists(memberPath)
        && get(memberPath).data.role == 'owner'
        && get(memberPath).data.status == 'active';
    }
    function validOrganizationCreate(organizationId) {
      let memberPath = /databases/$(database)/documents/organizationMembers/$(organizationId + '_' + request.auth.uid);
      return signedIn()
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(memberPath)
        && getAfter(memberPath).data.organizationId == organizationId
        && getAfter(memberPath).data.uid == request.auth.uid
        && getAfter(memberPath).data.role == 'owner'
        && getAfter(memberPath).data.status == 'active';
    }
    function validInitialOrganizationOwner(organizationId) {
      let organizationPath = /databases/$(database)/documents/organizations/$(organizationId);
      return signedIn()
        && !exists(organizationPath)
        && existsAfter(organizationPath)
        && getAfter(organizationPath).data.ownerId == request.auth.uid
        && getAfter(organizationPath).data.status == 'active';
    }
    function validWorkspaceCreate(workspaceId) {
      let memberPath = /databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid);
      return signedIn()
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'organizationId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'organizationId', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.organizationId == null || organizationAdmin(request.resource.data.organizationId))
        && existsAfter(memberPath)
        && getAfter(memberPath).data.workspaceId == workspaceId
        && getAfter(memberPath).data.uid == request.auth.uid
        && getAfter(memberPath).data.role == 'owner'
        && getAfter(memberPath).data.status == 'active';
    }
    function validInitialWorkspaceOwner(workspaceId) {
      let workspacePath = /databases/$(database)/documents/workspaces/$(workspaceId);
      return signedIn()
        && !exists(workspacePath)
        && existsAfter(workspacePath)
        && getAfter(workspacePath).data.ownerId == request.auth.uid
        && getAfter(workspacePath).data.status == 'active';
    }
    function validInviteWorkspaceMember(workspaceId) {
      let inviteId = request.resource.data.inviteId;
      let invitePath = /databases/$(database)/documents/workspaceInvites/$(inviteId);
      let workspacePath = /databases/$(database)/documents/workspaces/$(workspaceId);
      let invite = get(invitePath);
      let inviteAfter = getAfter(invitePath);
      return signedIn()
        && inviteId is string
        && inviteId.matches('^[a-f0-9]{64}$')
        && request.resource.data.role in ['member', 'viewer']
        && invite.data.tokenHash == inviteId
        && invite.data.workspaceId == workspaceId
        && get(workspacePath).data.status == 'active'
        && invite.data.role == request.resource.data.role
        && invite.data.status == 'active'
        && invite.data.maxUses == 1
        && invite.data.useCount == 0
        && invite.data.expiresAt > request.time
        && inviteAfter.data.status == 'consumed'
        && inviteAfter.data.useCount == 1
        && inviteAfter.data.consumedBy == request.auth.uid
        && inviteAfter.data.consumedAt == request.time;
    }
    function validInviteOrganizationMember(organizationId) {
      let inviteId = request.resource.data.inviteId;
      let invitePath = /databases/$(database)/documents/workspaceInvites/$(inviteId);
      let invite = get(invitePath);
      let inviteAfter = getAfter(invitePath);
      let workspacePath = /databases/$(database)/documents/workspaces/$(invite.data.workspaceId);
      let organizationPath = /databases/$(database)/documents/organizations/$(organizationId);
      return signedIn()
        && inviteId is string
        && inviteId.matches('^[a-f0-9]{64}$')
        && request.resource.data.role == 'member'
        && invite.data.tokenHash == inviteId
        && invite.data.organizationId == organizationId
        && get(organizationPath).data.status == 'active'
        && invite.data.status == 'active'
        && invite.data.maxUses == 1
        && invite.data.useCount == 0
        && invite.data.expiresAt > request.time
        && inviteAfter.data.status == 'consumed'
        && inviteAfter.data.useCount == 1
        && inviteAfter.data.consumedBy == request.auth.uid
        && inviteAfter.data.consumedAt == request.time
        && get(workspacePath).data.organizationId == organizationId;
    }
    function validWorkspaceInviteCreate(inviteId) {
      let workspaceId = request.resource.data.workspaceId;
      let workspacePath = /databases/$(database)/documents/workspaces/$(workspaceId);
      return signedIn()
        && inviteId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['tokenHash', 'tokenHint', 'workspaceId', 'workspaceName', 'organizationId', 'role', 'status', 'maxUses', 'useCount', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['tokenHash', 'tokenHint', 'workspaceId', 'workspaceName', 'organizationId', 'role', 'status', 'maxUses', 'useCount', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.tokenHash == inviteId
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceName == get(workspacePath).data.name
        && get(workspacePath).data.status == 'active'
        && request.resource.data.organizationId == get(workspacePath).data.organizationId
        && (request.resource.data.organizationId == null || organizationAdmin(request.resource.data.organizationId))
        && request.resource.data.role in ['member', 'viewer']
        && request.resource.data.status == 'active'
        && request.resource.data.maxUses == 1
        && request.resource.data.useCount == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(26, 'h')
        && workspaceAdmin(workspaceId);
    }
    function validWorkspaceInviteRevocation() {
      return workspaceAdminForDelete(resource.data.workspaceId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedBy', 'revokedAt']);
    }
    function validWorkspaceInviteConsumption(inviteId) {
      let memberPath = /databases/$(database)/documents/workspaceMembers/$(resource.data.workspaceId + '_' + request.auth.uid);
      return signedIn()
        && resource.data.tokenHash == inviteId
        && resource.data.status == 'active'
        && resource.data.maxUses == 1
        && resource.data.useCount == 0
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'consumed'
        && request.resource.data.useCount == 1
        && request.resource.data.consumedBy == request.auth.uid
        && request.resource.data.consumedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'useCount', 'consumedBy', 'consumedAt'])
        && existsAfter(memberPath)
        && getAfter(memberPath).data.inviteId == inviteId
        && getAfter(memberPath).data.uid == request.auth.uid
        && getAfter(memberPath).data.status == 'active';
    }
    function validCanvasCreate(workspaceId) {
      return request.resource.data.keys().hasAll(['workspaceId', 'name', 'createdBy', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['workspaceId', 'name', 'createdBy', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (workspaceEditor(workspaceId) || workspaceMemberAfter(workspaceId));
    }
    function validElementClock() {
      return request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 2147483647
        && request.resource.data.versionNonce is int
        && request.resource.data.versionNonce >= 0
        && request.resource.data.versionNonce <= 2147483647
        && request.resource.data.element.version == request.resource.data.version
        && request.resource.data.element.versionNonce == request.resource.data.versionNonce;
    }
    function incomingClockWins() {
      return request.resource.data.version > resource.data.version
        || (request.resource.data.version == resource.data.version
          && request.resource.data.versionNonce < resource.data.versionNonce);
    }
    function validCanvasDeletion(workspaceId) {
      return workspaceAdminForDelete(workspaceId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'deleting'
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedBy', 'deletedAt']);
    }
    function validWorkspaceDeletion(workspaceId) {
      return workspaceOwnerForDelete(workspaceId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'deleting'
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedBy', 'deletedAt']);
    }
    function validOrganizationDeletion(organizationId) {
      return organizationOwnerForDelete(organizationId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'deleting'
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedBy', 'deletedAt']);
    }
    function validOrganizationWorkspaceDetach(organizationId) {
      return resource.data.organizationId == organizationId
        && organizationAdminForDelete(organizationId)
        && request.resource.data.organizationId == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'updatedAt']);
    }
    function validOrganizationInviteDetach() {
      return resource.data.organizationId is string
        && organizationAdminForDelete(resource.data.organizationId)
        && request.resource.data.organizationId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId']);
    }
    function validCanvasFile(workspaceId, canvasId) {
      return request.resource.data.keys().hasAll(['workspaceId', 'canvasId', 'fileId', 'revision', 'chunkIndex', 'chunkCount', 'mimeType', 'created', 'data', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['workspaceId', 'canvasId', 'fileId', 'revision', 'chunkIndex', 'chunkCount', 'mimeType', 'created', 'data', 'updatedBy', 'updatedAt'])
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.canvasId == canvasId
        && request.resource.data.fileId is string
        && request.resource.data.fileId.size() > 0
        && request.resource.data.fileId.size() <= 200
        && request.resource.data.revision is string
        && request.resource.data.revision.size() > 0
        && request.resource.data.revision.size() <= 128
        && request.resource.data.chunkIndex is int
        && request.resource.data.chunkIndex >= 0
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 30
        && request.resource.data.chunkIndex < request.resource.data.chunkCount
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 128
        && request.resource.data.created is number
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function validPresence(workspaceId, canvasId, uid) {
      return workspaceMember(workspaceId)
        && canvasActive(workspaceId, canvasId)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'activeAt', 'expiresAt', 'pointer', 'pointerUpdatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.activeAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'm')
        && (!request.resource.data.keys().hasAny(['pointer']) || (request.resource.data.pointer is map
          && request.resource.data.pointer.keys().hasOnly(['x', 'y', 'tool', 'button'])
          && request.resource.data.pointer.x is number
          && request.resource.data.pointer.y is number
          && request.resource.data.pointer.tool in ['pointer', 'laser']
          && request.resource.data.pointer.button in ['up', 'down']))
        && (!request.resource.data.keys().hasAny(['pointerUpdatedAt']) || (request.resource.data.pointerUpdatedAt is timestamp
          && request.resource.data.pointerUpdatedAt <= request.time));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if workspaceMember(workspaceId)
        || (resource.data.organizationId is string && organizationAdminForDelete(resource.data.organizationId));
      allow create: if validWorkspaceCreate(workspaceId);
      allow update: if validWorkspaceDeletion(workspaceId)
        || (resource.data.organizationId is string && validOrganizationWorkspaceDetach(resource.data.organizationId));
      allow delete: if workspaceOwnerForDelete(workspaceId);

      match /canvases/{canvasId} {
        allow read: if workspaceMember(workspaceId);
        allow create: if validCanvasCreate(workspaceId);
        allow update: if validCanvasDeletion(workspaceId);
        allow delete: if workspaceAdminForDelete(workspaceId);

        match /elements/{elementId} {
          allow read: if workspaceMember(workspaceId);
          allow create: if workspaceEditor(workspaceId)
            && request.resource.data.keys().hasOnly(['workspaceId', 'canvasId', 'elementId', 'element', 'version', 'versionNonce', 'isDeleted', 'updatedBy', 'updatedAt'])
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.canvasId == canvasId
            && request.resource.data.elementId == elementId
            && request.resource.data.element.id == elementId
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && validElementClock();
          allow update: if workspaceEditor(workspaceId)
            && request.resource.data.keys().hasOnly(['workspaceId', 'canvasId', 'elementId', 'element', 'version', 'versionNonce', 'isDeleted', 'updatedBy', 'updatedAt'])
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.canvasId == resource.data.canvasId
            && request.resource.data.elementId == resource.data.elementId
            && request.resource.data.element.id == elementId
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && validElementClock()
            && incomingClockWins();
          allow delete: if workspaceAdminForDelete(workspaceId);
        }

        match /files/{fileChunkId} {
          allow read: if workspaceMember(workspaceId);
          allow create, update: if workspaceEditor(workspaceId)
            && canvasActive(workspaceId, canvasId)
            && validCanvasFile(workspaceId, canvasId);
          allow delete: if workspaceAdminForDelete(workspaceId)
            && resource.data.workspaceId == workspaceId
            && resource.data.canvasId == canvasId;
        }

        match /presence/{uid} {
          allow read: if workspaceMember(workspaceId);
          allow create, update: if validPresence(workspaceId, canvasId, uid);
          allow delete: if (workspaceMember(workspaceId) && request.auth.uid == uid)
            || workspaceAdminForDelete(workspaceId);
        }
      }
    }

    match /workspaceMembers/{membershipId} {
      allow get: if signedIn() && (membershipId.matches('^.*_' + request.auth.uid + '$')
        || resource.data.uid == request.auth.uid || workspaceMember(resource.data.workspaceId));
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || workspaceMember(resource.data.workspaceId));
      allow create: if request.resource.data.keys().hasAll(['workspaceId', 'uid', 'role', 'status', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['workspaceId', 'uid', 'role', 'status', 'joinedAt', 'inviteId', 'displayName', 'email'])
        && request.resource.data.workspaceId is string
        && membershipId == request.resource.data.workspaceId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.joinedAt == request.time
        && (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 128))
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (request.resource.data.role == 'owner'
          ? validInitialWorkspaceOwner(request.resource.data.workspaceId)
          : validInviteWorkspaceMember(request.resource.data.workspaceId));
      allow update: if false;
      allow delete: if workspaceOwnerForDelete(resource.data.workspaceId);
    }
    match /organizations/{organizationId} {
      allow read: if organizationMember(organizationId);
      allow create: if validOrganizationCreate(organizationId);
      allow update: if validOrganizationDeletion(organizationId);
      allow delete: if organizationOwnerForDelete(organizationId);
    }
    match /organizationMembers/{membershipId} {
      allow get: if signedIn() && (membershipId.matches('^.*_' + request.auth.uid + '$')
        || resource.data.uid == request.auth.uid || organizationAdminForDelete(resource.data.organizationId));
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || organizationAdminForDelete(resource.data.organizationId));
      allow create: if request.resource.data.keys().hasAll(['organizationId', 'uid', 'role', 'status', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['organizationId', 'uid', 'role', 'status', 'joinedAt', 'inviteId', 'displayName', 'email'])
        && request.resource.data.organizationId is string
        && membershipId == request.resource.data.organizationId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.joinedAt == request.time
        && (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 128))
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (request.resource.data.role == 'owner'
          ? validInitialOrganizationOwner(request.resource.data.organizationId)
          : validInviteOrganizationMember(request.resource.data.organizationId));
      allow update: if false;
      allow delete: if organizationOwnerForDelete(resource.data.organizationId);
    }

    match /workspaceInvites/{inviteId} {
      allow get: if signedIn() && resource.data.tokenHash == inviteId;
      allow list: if workspaceAdminForDelete(resource.data.workspaceId)
        || (resource.data.organizationId is string && organizationAdminForDelete(resource.data.organizationId));
      allow create: if validWorkspaceInviteCreate(inviteId);
      allow update: if validWorkspaceInviteRevocation()
        || validWorkspaceInviteConsumption(inviteId)
        || validOrganizationInviteDetach();
      allow delete: if workspaceAdminForDelete(resource.data.workspaceId);
    }
    match /mcpAccessTokens/{documentId} { allow read, write: if false; }
    match /billingCustomers/{documentId} { allow read, write: if false; }
    match /subscriptions/{documentId} { allow read, write: if false; }
    match /entitlements/{documentId} { allow read, write: if false; }
    match /paymentEvents/{documentId} { allow read, write: if false; }
    match /auditLogs/{documentId} { allow read, write: if false; }
    match /rateLimits/{documentId} { allow read, write: if false; }
    match /billingJobs/{documentId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
