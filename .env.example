# Firebase web app configuration (Firebase Console > Project settings > Your apps).
# Keep separate Vite env files and Firebase web apps/projects for development,
# staging, and production; never point a development build at production billing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Public HTTPS origin for this environment's AlgoGlyph Functions API (workspace,
# invite, MCP-token, billing, and managed-agent endpoints). Use the local
# Functions emulator URL during development. This is an origin, not a secret.
VITE_ALGOGLYPH_API_URL=

# Deprecated compatibility alias; omit for new deployments.
VITE_BILLING_API_URL=

# No Stripe, Razorpay, or BillDesk private credential belongs in a VITE_* variable.
# BillDesk is not enabled: no historical implementation or merchant-specific
# protocol contract exists in this repository. See docs/billing-deployment.md.
