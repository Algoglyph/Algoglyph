{
  "name": "scratchpad",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "predev": "npm run content:index",
    "dev": "vite",
    "content:inventory": "node scripts/auditArticleInventory.mjs",
    "content:inventory:strict": "node scripts/auditArticleInventory.mjs --strict",
    "content:inventory:dsa": "node scripts/auditDsaInventory.mjs",
    "content:inventory:dsa:strict": "node scripts/auditDsaInventory.mjs --strict",
    "content:index": "node scripts/generateArticleIndex.mjs",
    "test:content": "node scripts/validateContentSystem.mjs",
    "test:content:code": "node scripts/validateDsaCodeExamples.mjs",
    "mcp:connector": "node scripts/algoglyph-mcp-connector.mjs",
    "test:mcp": "node --test --test-concurrency=1 packages/mcp-connector/test/connector.integration.test.mjs",
    "test:mcp:ui": "node --test packages/mcp-connector/test/browser-connection-state.test.mjs",
    "test:mcp:package": "node packages/mcp-connector/test/package-release.mjs",
    "build:functions": "npm run build --prefix firebase-functions",
    "test:billing": "npm test --prefix firebase-functions",
    "test:firebase": "npm run test:emulator --prefix firebase-functions",
    "lint:billing": "eslint \"firebase-functions/src/**/*.ts\" src/lib/billing src/lib/workspaces src/lib/firebaseAuth.ts src/components/AuthProvider.tsx src/components/authContext.ts src/components/BillingDialog.tsx src/components/CloudCanvasPage.tsx src/components/CloudWorkspacesPage.tsx src/components/InvitePage.tsx src/components/McpConnectDialog.tsx",
    "test:diagrams": "node scripts/validateDiagramLayout.mjs",
    "test:seo": "node scripts/validateSeo.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generateStaticSeoPages.mjs",
    "lint": "eslint .",
    "lint:mcp": "eslint \"packages/mcp-connector/**/*.mjs\" src/lib/mcp src/components/McpConnectDialog.tsx src/components/landing/LandingContinuation.tsx",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name algoglyph",
    "electron": "electron .",
    "electron:build": "ELECTRON_BUILD=1 npm run build && electron-builder",
    "library:catalog": "node scripts/generateLibraryCatalog.mjs",
    "seo:sitemap": "node scripts/generateSitemap.js",
    "prebuild": "npm run content:index && node scripts/generateLibraryCatalog.mjs && node scripts/generateSitemap.js"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@remotion/tailwind": "^4.0.482",
    "@tiptap/extension-code-block-lowlight": "^3.26.1",
    "@tiptap/extension-table": "^3.26.1",
    "@tiptap/extension-table-cell": "^3.26.1",
    "@tiptap/extension-table-header": "^3.26.1",
    "@tiptap/extension-table-row": "^3.26.1",
    "@tiptap/markdown": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/headless": "^6.0.0",
    "autoprefixer": "^10.5.1",
    "firebase": "^12.18.0",
    "framer-motion": "^12.42.0",
    "headroom-ai": "^0.22.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.21.0",
    "node-pty": "1.2.0-beta.15",
    "postcss": "^8.5.26",
    "posthog-js": "^1.393.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "scheduler": "^0.27.0",
    "undici": "^7.29.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "minimatch": "^10.2.5",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.algoglyph.app",
    "productName": "Algoglyph",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Algoglyph"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.png"
    },
    "dmg": {
      "backgroundColor": "#0c0c0e",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  }
}
